[Unit]
Description=Zako Panel node agent uninstaller
After=zako-agent.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c 'if [ -f /var/lib/zako-agent/uninstall-remove-xray ]; then exec /usr/local/bin/zako-agent uninstall --local-only --remove-xray; else exec /usr/local/bin/zako-agent uninstall --local-only; fi'
