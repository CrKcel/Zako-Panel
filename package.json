{
	"name": "zako-panel",
	"version": "0.1.0",
	"private": true,
	"description": "Lightweight proxy node management panel",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/worker",
		"apps/web",
		"packages/contracts"
	],
	"scripts": {
		"dev": "wrangler dev",
		"dev:web": "npm run dev -w @zako/web",
		"build": "npm run build -w @zako/web",
		"build:worker": "wrangler deploy --dry-run",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:agent": "cd apps/agent && go test ./...",
		"test:downloads": "bash deploy/tests/package-release.sh && bash deploy/tests/stage-downloads.sh",
		"test:all": "npm test && npm run test:agent && npm run test:downloads",
		"contracts:generate": "npm run generate -w @zako/contracts",
		"db:migrate:local": "wrangler d1 migrations apply zako-panel --local",
		"db:migrate:remote": "wrangler d1 migrations apply zako-panel --remote",
		"bootstrap": "node scripts/bootstrap.mjs",
		"capacity": "node scripts/capacity.mjs",
		"deploy": "npm run build && wrangler deploy",
		"deploy:downloads": "wrangler deploy --config wrangler.downloads.jsonc",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.160.1"
	}
}
