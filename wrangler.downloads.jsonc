{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zako-agent-downloads",
	"compatibility_date": "2026-11-10",
	"workers_dev": false,
	// Assets-only Worker: Cloudflare serves downloads without invoking a script.
	"assets": {
		"directory": "apps/downloads/dist",
		"not_found_handling": "none",
	},
	// Replace the host and zone with the real panel values before deploying.
	"routes": [
		{
			"pattern": "panel.example.com/dl/*",
			"zone_name": "example.com",
		},
	],
}
