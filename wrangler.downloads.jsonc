{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zako-agent-downloads",
	"compatibility_date": "2026-11-10",
	"workers_dev": false,
	// Assets-only Worker: Cloudflare serves downloads without invoking a script.
	"assets": {
		"directory": "apps/downloads/dist",
		"not_found_handling": "none",
	},
	// The download prefix shares the panel hostname. A Custom Domain covers a whole
	// hostname, so serving one path prefix needs a route on the zone.
	"routes": [
		{
			"pattern": "332711.xyz/dl/*",
			"zone_name": "332711.xyz",
		},
	],
}
