{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zako-panel",
	"main": "apps/worker/src/index.ts",
	"compatibility_date": "2026-11-10",
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MyDurableObject"],
		},
		{
			"tag": "v2",
			"deleted_classes": ["MyDurableObject"],
		},
	],
	"assets": {
		"directory": "apps/web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/sub/*"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zako-panel",
			"database_id": "ebe284ec-1bde-47f7-8a69-782c311f7d32",
		},
	],
	"vars": {
		"ENVIRONMENT": "production",
		"ACCESS_AUD": "200b776f3343eef910e4ed075d5f23286850f29a2c454f6cd5d0b79673b43c68",
		"ACCESS_TEAM_DOMAIN": "icy-voice-152b.cloudflareaccess.com",
	},
	"triggers": {
		"crons": ["*/15 * * * *", "17 3 * * *"],
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
